# Exemplo de configuração do Jarvis. Não tem segredo.
# Copie para ~/.jarvis/.env e preencha o que for usar.
# Variável que já existe no ambiente não é coberta.
# O arquivo ~/.jarvis/.env fica fora do git.
# Gmail, Jira e GitHub ficam somente leitura. O Jarvis não envia e-mail.

# Pastas
# Pasta local de log, estado e revisão.
# JARVIS_HOME=~/.jarvis
# Arquivo de ambiente. Variável que já existe no processo não é coberta.
# JARVIS_ENV_FILE=~/.jarvis/.env

# Vault
# Clone local do vault. Vazio desliga a leitura das notas.
JARVIS_VAULT=
# Pastas relativas do vault, separadas por vírgula, que não saem desta máquina.
JARVIS_PASTAS_PRIVADAS=
# Pastas do vault, separadas por vírgula, fora da busca, dos cartões e dos lembretes. Não é sigilo: o Claude continua lendo essas pastas.
JARVIS_PASTAS_IGNORADAS=
# Tag de nota que fica só no modelo local.
JARVIS_TAG_SIGILOSA=sigiloso
# off usa o vault sem pull, commit ou push.
# JARVIS_VAULT_SYNC=on
# Remoto git esperado. Vazio aceita o origin do clone. Se preenchido, outro destino é recusado. HTTPS e SSH do mesmo repositório contam igual.
# JARVIS_VAULT_REMOTE=
# Se definida, o clone já precisa estar nessa branch.
# JARVIS_VAULT_BRANCH=
# Segundos de cada comando git do sync.
# JARVIS_VAULT_GIT_TIMEOUT=120
# Segundos da checagem de remoto no diagnóstico.
# JARVIS_DOCTOR_GIT_TIMEOUT=10

# Executáveis
# Executável do git, nome no PATH ou caminho completo.
# JARVIS_GIT_BIN=git
# Executável do Claude Code.
# JARVIS_CLAUDE_BIN=claude
# Executável do GitHub CLI. A consulta de PR é só leitura.
# JARVIS_GH_BIN=gh
# Modelo do Claude. Vazio usa o padrão da conta.
# JARVIS_MODEL=

# Pastas
# Pasta de trabalho quando o vault não está configurado.
# JARVIS_WORKSPACE=./workspace
# Arquivo do prompt montado fora do vault.
# JARVIS_PROMPT_FILE=./workspace/prompt-vault.md

# Executáveis
# Ferramentas do Claude, separadas por vírgula. Com vault e sem esta variável, entram Edit e Write.
# JARVIS_ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch
# Segundos de cada consulta ao Claude.
# JARVIS_TURN_TIMEOUT=300

# Pastas
# Log local rotativo, fora do vault.
# JARVIS_LOG=~/.jarvis/logs/jarvis.log
# Estado local dos avisos. Não guarda segredo.
# JARVIS_STATE=~/.jarvis/state.json

# Estudo
# Agendamento da revisão espaçada, fora do vault.
# JARVIS_REVISAO=~/.jarvis/revisao.json

# Voz
# Backend de voz: auto, say, edge ou sapi.
# JARVIS_TTS=auto
# Voz do macOS.
# JARVIS_VOICE=Luciana
# Velocidade da fala do backend say.
# JARVIS_SPEECH_RATE=190
# Voz neural do backend edge.
# JARVIS_EDGE_VOICE=pt-BR-AntonioNeural
# Velocidade da fala do backend edge.
# JARVIS_EDGE_RATE=+10%
# Segundos para sintetizar com o backend edge.
# JARVIS_EDGE_TIMEOUT=30
# Velocidade da fala do backend sapi, de -10 a 10.
# JARVIS_SAPI_RATE=1

# Ouvido
# faster-whisper, whisper ou auto. auto prefere o faster-whisper.
# JARVIS_STT=auto
# Tamanho do modelo local: tiny, base, small ou medium.
# JARVIS_WHISPER_MODEL=small
# Idioma da transcrição.
# JARVIS_LANGUAGE=pt
# Sensibilidade do detector de silêncio.
# JARVIS_SILENCE_THRESHOLD=0.012
# Pausa, em segundos, que encerra a captura.
# JARVIS_SILENCE_SECONDS=1.2
# Segundos sem fala antes de desistir da captura.
# JARVIS_NO_SPEECH_SECONDS=6
# Duração máxima, em segundos, de uma captura.
# JARVIS_MAX_RECORD_SECONDS=60
# Modelo ONNX da palavra de ativação.
# JARVIS_WAKE_MODEL=hey_jarvis_v0.1
# Sensibilidade da palavra de ativação.
# JARVIS_WAKE_THRESHOLD=0.5
# Segundos de continuação depois da resposta.
# JARVIS_FOLLOWUP_NO_SPEECH_SECONDS=4

# Conversa
# Nome no remetente das notas de pedido. O padrão é neutro.
# JARVIS_NOME=usuario
# on guarda as últimas trocas em ~/.jarvis/contexto.json.
# JARVIS_CONTEXTO=on
# Quantas trocas recentes acompanham o pedido seguinte.
# JARVIS_CONTEXTO_TURNOS=6
# Arquivo do contexto. Não leva trecho de nota.
# JARVIS_CONTEXTO_ARQUIVO=~/.jarvis/contexto.json
# Fala a primeira frase assim que ela fecha.
# JARVIS_STREAM=on
# Prazo em segundos de explicação, teste ou confirmação. cancela ou para encerra.
# JARVIS_MODO_PRAZO=1800

# Painel
# Painel local. off desliga.
# JARVIS_PANEL=on
# Porta do painel. Não exponha fora da máquina.
# JARVIS_PANEL_PORT=8765
# Só loopback. Outro valor é ignorado.
# JARVIS_PANEL_BIND=127.0.0.1
# Abrir o navegador ao iniciar.
# JARVIS_PANEL_OPEN=on
# off não cria o ícone da bandeja.
# JARVIS_BANDEJA=on

# Consulta
# Porta da consulta somente leitura.
# JARVIS_CONSULT_PORT=8766
# 127.0.0.1 ou lan. 0.0.0.0 e IP público são recusados.
# JARVIS_CONSULT_BIND=127.0.0.1
# off ignora o modelo local mesmo com os pesos em disco.
# JARVIS_CONSULT_MODEL=on
# Pasta dos pesos do modelo gratuito.
# JARVIS_CONSULT_MODEL_DIR=~/.jarvis/models/consult

# Avisos
# Intervalo, em segundos, da busca de lembretes vencidos.
# JARVIS_REMINDER_SECONDS=15
# off desliga o briefing e o resumo do fim do dia.
# JARVIS_CHECKIN=on
# Briefing no primeiro arranque do dia.
# JARVIS_CHECKIN_MORNING=on
# Resumo do fim do dia, com oferta de gravar.
# JARVIS_CHECKIN_EVENING=on
# Horário local do resumo, HH:MM.
# JARVIS_CHECKIN_EVENING_AT=18:30
# off desliga os alertas de PR, Jira e e-mail. Só leitura.
# JARVIS_RADAR=on
# Intervalo, em segundos, da consulta somente leitura.
# JARVIS_RADAR_SECONDS=300
# Segundos mínimos entre um aviso e outro.
# JARVIS_RADAR_COOLDOWN=900

# Estudo
# Cartões da revisão por dia, entre 1 e 50.
# JARVIS_REVISAO_LIMITE=10
# Cartões novos por dia, entre 0 e 50. O limite do dia continua valendo.
# JARVIS_REVISAO_NOVOS=5
# Pastas ou tags, separadas por vírgula. Esses cartões entram primeiro.
# JARVIS_REVISAO_PRIORIDADE=

# Integrações
# Endereço do Jira. O Jarvis só lê issues.
# JIRA_URL=
# E-mail da conta Atlassian. Só leitura.
# JIRA_EMAIL=
# Token de API do Jira. Só leitura. Não commite.
# JIRA_TOKEN=
# Conta Gmail lida por IMAP. O Jarvis não envia e-mail.
# GMAIL_EMAIL=
# Senha de app do Gmail. Não envia e-mail. Não commite.
# GMAIL_APP_PASSWORD=
# Servidor IMAP.
# GMAIL_IMAP_HOST=imap.gmail.com
# Porta IMAP.
# GMAIL_IMAP_PORT=993

# Telegram
# Token do bot. Vazio desliga. Não commite.
# TELEGRAM_BOT_TOKEN=
# ID numérico do único usuário. Sem ele o bot não conecta.
# TELEGRAM_ALLOWED_USER_ID=
# on também envia a resposta em áudio.
# TELEGRAM_VOICE_REPLY=off
# ID numérico da conversa privada. Vazio usa o ID do usuário. Outro chat é recusado.
# TELEGRAM_CHAT_ID=
# Mensagens por minuto no Telegram, entre 1 e 60.
# TELEGRAM_LIMITE=20

# Integrações
# Token do Readwise. Só baixa destaque. Não commite.
# READWISE_TOKEN=
# Pasta do clone para cada livro ou artigo.
# JARVIS_READWISE_PASTA=Leituras/Readwise
# Pasta do clone para uma nota por livro importado do Kindle, PDF ou KOReader.
# JARVIS_DESTAQUES_PASTA=Leituras/Destaques
# Pasta de entrada de My Clippings, PDF e exportação do KOReader. Fora do vault.
# JARVIS_DESTAQUES_ENTRADA=~/.jarvis/destaques

# Captura
# Pasta dos livros. A busca nos livros usa este caminho.
# JARVIS_LIVROS_PASTA=Tecnologia/Livros
# Pasta do vault para o resumo de um vídeo do YouTube.
# JARVIS_VIDEOS_PASTA=Tecnologia/Vídeos
# Pasta dos cursos. A busca nos cursos usa este caminho.
# JARVIS_CURSOS_PASTA=Tecnologia/Cursos
# Pasta do vault para o resumo de um artigo.
# JARVIS_ARTIGOS_PASTA=Tecnologia/Artigos
# Pasta do vault para o resumo de um episódio.
# JARVIS_PODCASTS_PASTA=Tecnologia/Podcasts
# Pasta da nota de estudo de um vídeo ou áudio. Uma nota por vídeo.
# JARVIS_ESTUDO_MIDIA_PASTA=Estudos/Mídia
# Pasta de entrada de áudio e de links.txt, fora do vault. A fila pede confirmação.
# JARVIS_MIDIA_ENTRADA=~/.jarvis/midia
# off grava o resumo sem cartões em rascunho.
# JARVIS_CAPTURA_CARTOES=on

# Avisos
# on envia o que aprendi esta semana no Telegram, no domingo.
# JARVIS_DIGEST=off
# Horário desse envio. Vazio segue o check-in da tarde.
# JARVIS_DIGEST_AT=18:30
# on envia o bom dia no Telegram, uma vez por dia.
# JARVIS_BRIEFING_TELEGRAM=off
# Horário local desse envio, HH:MM.
# JARVIS_BRIEFING_HORA=07:30
# on envia no Telegram, uma vez por dia, o título de uma nota antiga e um ponto seu. Nota privada fica de fora.
# JARVIS_LEMBRETE_NOTA=off
# Horário local desse lembrete de nota, HH:MM. O padrão é desligado.
# JARVIS_LEMBRETE_NOTA_HORA=08:00
# on lembra no Telegram, no domingo, de começar a revisão semanal. Não manda texto de nota. O padrão é desligado.
# JARVIS_REVISAO_SEMANAL=off
# Horário local desse lembrete de domingo, HH:MM. Só vale com JARVIS_REVISAO_SEMANAL=on.
# JARVIS_REVISAO_SEMANAL_HORA=10:00
# on manda no Telegram, à noite, um aviso se não houve revisão no dia. Não leva texto de nota. O padrão é desligado.
# JARVIS_TOQUE_SEQUENCIA=off
# Horário local desse aviso, HH:MM. Só vale com JARVIS_TOQUE_SEQUENCIA=on.
# JARVIS_TOQUE_SEQUENCIA_HORA=20:00
# on avisa no Telegram quando a sessão de estudo acaba. Não leva texto de nota nem o que você aprendeu. O padrão é desligado.
# JARVIS_SESSAO_TELEGRAM=off
# on adia briefing, lembrete e resumo enquanto a sessão de estudo está em andamento. off deixa esses avisos passarem.
# JARVIS_SESSAO_SILENCIO=on

# Cérebro
# Nota da persona, relativa ao clone e fora de .obsidian.
# JARVIS_PERSONA=Jarvis/Persona.md
# claude é o padrão. ollama atende pergunta simples.
# JARVIS_CEREBRO=claude
# Endereço do Ollama, sem usuário nem senha na URL.
# JARVIS_OLLAMA_URL=http://127.0.0.1:11434
# Modelo local quando JARVIS_CEREBRO=ollama.
# JARVIS_OLLAMA_MODEL=llama3.2
# Segundos da resposta local.
# JARVIS_OLLAMA_TIMEOUT=20

# Estudo
# Minutos da sessão de estudo quando o pedido não diz o tempo. Entre 1 e 180.
# JARVIS_SESSAO_MINUTOS=25
# Minutos de pausa depois da sessão, no estilo Pomodoro. 0 desliga a pausa. Entre 0 e 60.
# JARVIS_SESSAO_PAUSA=5
# meta anexa o que você aprendeu na nota do tema. diario anexa na nota do dia. Só depois do sim.
# JARVIS_SESSAO_NOTA=meta
# Pasta da nota do tema quando ainda não existe nota de meta.
# JARVIS_SESSAO_PASTA=Estudos/Sessoes
# Cartões de me testa sobre, entre 1 e 8.
# JARVIS_ESTUDO_LIMITE=3
# on também grava a meta de quero aprender numa nota do vault. O padrão fica só em ~/.jarvis.
# JARVIS_METAS_VAULT=off
# Pasta da nota de meta quando JARVIS_METAS_VAULT=on.
# JARVIS_METAS_PASTA=Estudos/Metas
# Pasta do mapa de conteúdo gravado depois da confirmação de conecta ideias.
# JARVIS_MAPAS_PASTA=Estudos/Mapas
# Pasta da nota revisao-semanal-AAAA-Www.md, gravada depois da confirmação.
# JARVIS_REVISAO_SEMANAL_PASTA=Diario/Revisao
# on pede ao cérebro só quando a resposta fica parecida.
# JARVIS_ESTUDO_CEREBRO=off

# Consulta
# Nota de índice no clone. off desliga.
# JARVIS_INDICE=indice.md
# palavras, semantica ou hibrida. O padrão é palavras e a busca não muda. semantica e hibrida usam embeddings só nesta máquina, gravados em ~/.jarvis.
# JARVIS_BUSCA=palavras

# Diagnóstico
# 1 pula a checagem de microfone. Útil sem placa de áudio.
# JARVIS_SKIP_HARDWARE=

# Manutenção
# off recusa a atualização do código. O vault não entra nessa atualização.
# JARVIS_ATUALIZAR=on
# Segundos do git pull do código. Não vale para o vault.
# JARVIS_ATUALIZAR_TIMEOUT=120
# Linhas finais do log no relatório, sem o texto da mensagem.
# JARVIS_RELATORIO_LINHAS=40
# Pasta do zip de diagnóstico. Vazia usa a pasta do usuário.
# JARVIS_RELATORIO_PASTA=
